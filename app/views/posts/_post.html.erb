<div class="post">
  <div class="author">
    <strong><%= post.author.username %></strong>

    <% follow = Follow.find_by(follower: current_user, following: post.author) %>
    <% if follow %>
      <%= button_to "Unfollow", follow, method: :delete %>
    <% elsif current_user != post.author %>
      <%= button_to "Follow", follows_url, params: { following_id: post.author.id } %>
    <% end %>
  </div>

  <div class="content">
    <%= post.content %>
  </div>

  <div class="likes">
    <%= post.likes.count %> likes
    <% like = Like.find_by(user: current_user, post: post) %>
    <% if like %>
      <%= button_to "Unlike", like, method: :delete %>
    <% else %>
      <%= button_to "Like", likes_url, params: { post_id: post.id } %>
    <% end %>
  </div>
  
  <div class="comments">
    <%= post.comments.count %> comments

    <% post.comments.each do | comment | %>
      <%= render "comments/comment", comment: comment %>
    <% end %>

    <%= form_with url: comments_url do |f| %>
      <%= f.hidden_field :commentable_type, value: post.class.name %>
      <%= f.hidden_field :commentable_id, value: post.id %>
      <div>
        <%= f.text_field :content %>
      </div>
      <div>
        <%= f.submit "Comment" %>
      </div>
    <% end %>
  </div>
</div>
